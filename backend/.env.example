# ─────────────────────────────────────────────────────────────────────────
# GraphIQ B2B Influencer Platform — Environment Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────

# JWT Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Neo4j
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
